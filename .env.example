# InferBox runtime configuration
# Copy this to .env and edit the values.

# Server
INFERBOX_HOST=0.0.0.0
INFERBOX_PORT=8811

# Auth: primary key, or comma-separated "key:label" additional keys
INFERBOX_API_KEY=change-me-to-a-strong-random-string
# INFERBOX_API_KEYS=key1:project-a,key2:project-b

# Rate limiting (per API key, requests per minute)
INFERBOX_RATE_LIMIT_PER_MIN=600

# Model manager
INFERBOX_TOTAL_VRAM_MB=12000
INFERBOX_IDLE_TIMEOUT=300
INFERBOX_MODELS_CONFIG=/path/to/inferbox/models.yaml

# Preload on startup (comma-separated model IDs from models.yaml)
INFERBOX_PRELOAD=qwen3-vl-embed,bge-reranker

# Graceful shutdown (seconds to wait for in-flight requests)
INFERBOX_DRAIN_TIMEOUT=30

# Micro-batching (coalesces concurrent requests into one forward pass)
INFERBOX_ENABLE_MICRO_BATCHING=true
INFERBOX_MICRO_BATCH_WINDOW_MS=20
INFERBOX_MICRO_BATCH_MAX_SIZE=64

# Audit log (optional JSONL file, leave empty to disable)
INFERBOX_AUDIT_LOG=

# OpenTelemetry (optional — set OTLP endpoint to enable)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# HuggingFace cache (so downloaded models survive restart)
HF_HOME=/root/.cache/huggingface
